{
  // Node code: build and harness scripts, and all unit tests (node:test).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.test.ts",
    "src/**/testing.ts",
    "entrypoints/**/*.test.ts"
  ]
}
